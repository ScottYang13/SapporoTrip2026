<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>北海道札幌 7 天 6 夜行程</title>
    <!-- 引入 marked.js 解析器 -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body style="margin: 0; padding: 20px; background-color: #0f172a; color: #ffffff;">

    <div id="content">資料載入中...</div>

    <script>
        // 您的 Google Apps Script Web App 網址
        const gasApiUrl = 'https://script.google.com/macros/s/AKfycbzFRtKvX3EiI2R9UdK7EFQQDLC63r6u6IzvSy5OtwpiedbvEFAn11nOkE2dqpVD9rutoA/exec';

        // 加上 ?t= 時間戳記防瀏覽器快取
        fetch(gasApiUrl + '?t=' + Date.now())
            .then(response => {
                if (!response.ok) {
                    throw new Error('HTTP 錯誤：' + response.status);
                }
                return response.text();
            })
            .then(mdText => {
                const container = document.getElementById('content');
                // 將 Markdown 轉為 HTML 寫入頁面
                container.innerHTML = marked.parse(mdText);

                // 執行內嵌的 <script> 標籤 (如有計時器或互動按鈕)
                const scripts = container.querySelectorAll("script");
                scripts.forEach(oldScript => {
                    const newScript = document.createElement("script");
                    Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                    newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
            })
            .catch(error => {
                document.getElementById('content').innerHTML = '載入失敗：' + error.message;
            });
    </script>

</body>
</html>
